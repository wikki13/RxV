FROM python:3.12-slim
WORKDIR /srv/rxv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt && useradd --create-home --uid 10001 rxv
COPY app ./app
RUN mkdir -p /data/uploads /data/reports && chown -R rxv:rxv /srv/rxv /data
USER rxv
EXPOSE 7860
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "7860"]
